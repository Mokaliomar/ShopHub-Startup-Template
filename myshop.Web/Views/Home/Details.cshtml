@model ProductShopIndexVM

@{
    ViewBag.PageTitle = "Product Details";
    ViewBag.CardTitle = Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    /* كارت تفاصيل المنتج الأساسي */
    .details-card, .reviews-card {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid #d0d7de;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
        padding: 30px;
        margin-top: 30px;
        margin-bottom: 30px;
    }

    .img-container {
        background-color: #f8fafc;
        border: 1px solid #d0d7de;
        border-radius: 12px;
        padding: 20px;
        height: 400px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .img-container img {
        max-height: 100%;
        max-width: 100%;
        object-fit: contain;
    }

    .product-name {
        color: #1e3a8a;
        font-weight: 700;
        font-size: 2rem;
        margin-bottom: 10px;
    }

    .category-badge {
        background-color: #f1f5fb;
        color: #1e40af;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 20px;
        border: 1px solid #7f9cf5;
        display: inline-block;
        font-size: 0.85rem;
        margin-bottom: 20px;
    }

    .price-tag {
        font-size: 1.8rem;
        font-weight: 700;
        color: #1e40af;
        margin-bottom: 20px;
        display: block;
    }

    .description-title, .section-title {
        color: #1e3a8a;
        font-weight: 700;
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 2px solid #f1f5fb;
    }

    .description-text {
        color: #4a5568;
        line-height: 1.7;
        font-size: 1rem;
        margin-bottom: 30px;
    }

    .btn-action {
        padding: 12px 24px;
        font-weight: 600;
        border-radius: 8px;
        transition: 0.25s ease;
    }

    .btn-add-cart {
        background-color: #1e40af;
        color: white;
        border: none;
        box-shadow: 0 4px 12px rgba(30, 64, 175, 0.3);
    }

    .btn-add-cart:hover {
        background-color: #1e3a8a;
        color: white;
    }

    .btn-back {
        border: 1px solid #a0aec0;
        color: #4a5568;
        background: transparent;
    }

    .btn-back:hover {
        background-color: #f7fafc;
        color: #1e3a8a;
    }

    /* تنسيقات المراجعات والتقييمات */
    .rating-summary-box {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    .avg-rate-number {
        font-size: 2.5rem;
        font-weight: 800;
        color: #1e3a8a;
    }

    .stars-outer {
        color: #f59e0b;
        font-size: 1.2rem;
    }

    .user-avatar-initials {
        width: 48px;
        height: 48px;
        background-color: #1e40af;
        color: #ffffff;
        font-weight: 700;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        text-transform: uppercase;
    }

    .review-item {
        padding: 18px 0;
        border-bottom: 1px solid #e2e8f0;
    }

    .review-item:last-child {
        border-bottom: none;
    }
</style>

<div class="container">
    <!-- كارت تفاصيل المنتج -->
    <div class="details-card">
        <div class="row g-5">
            <div class="col-md-5">
                <div class="img-container">
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="~/@Model.Image" alt="@Model.Name" />
                    }
                    else
                    {
                        <img src="/images/no-image.png" alt="No Image Available" />
                    }
                </div>
            </div>

            <div class="col-md-7 d-flex flex-column justify-content-between">
                <div>
                    <h1 class="product-name">@Model.Name</h1>
                    <span class="category-badge">
                        <i class="fa-solid fa-layer-group me-1"></i> @Model.CategoryName
                    </span>

                    <span class="price-tag">$@Model.Price.ToString("F2")</span>

                    <h5 class="description-title"><i class="fa-solid fa-align-left me-1"></i> Product Description</h5>
                    <p class="description-text">@Model.Description</p>
                </div>

                <div class="d-flex gap-3 mt-auto">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-action btn-back">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to Shop
                    </a>
                    <a asp-controller="Order" asp-action="AddToCart" asp-route-id="@Model.Id" class="btn btn-action btn-add-cart flex-grow-1">
                        <i class="fa-solid fa-cart-plus me-1"></i> Add to Cart
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- كارت التقييمات والمراجعات (بالتتابع الرأسي) -->
    <div class="reviews-card">
        <h4 class="section-title"><i class="fa-solid fa-star-half-stroke me-2"></i> Ratings & Reviews</h4>

        <!-- 1. ملخص التقييم العام -->
        <div class="rating-summary-box">
            @* <div class="avg-rate-number">@Model.AverageRate.ToString("0.0")</div> *@
            <div>
                <div class="stars-outer mb-1">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Math.Round(Model.AverageRate))
                        {
                            <i class="fa-solid fa-star"></i>
                        }
                        else
                        {
                            <i class="fa-regular fa-star"></i>
                        }
                    }
                </div>
                <div class="text-muted small">Based on @Model.ReviewsCount review(s)</div>
            </div>
        </div>

        <!-- 2. نموذج إضافة تقييم -->
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="card p-4 border rounded-3 mb-4 bg-light">
                <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-pen-to-square me-2"></i> Leave a Review</h5>
                <form asp-controller="Home" asp-action="AddReview" method="post">
                    <input type="hidden" name="ProductId" value="@Model.Id" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Your Rating</label>
                        <select name="ProductRate" class="form-select w-auto" required>
                            <option value="5">⭐⭐⭐⭐⭐ (5 - Excellent)</option>
                            <option value="4">⭐⭐⭐⭐ (4 - Very Good)</option>
                            <option value="3">⭐⭐⭐ (3 - Average)</option>
                            <option value="2">⭐⭐ (2 - Poor)</option>
                            <option value="1">⭐ (1 - Terrible)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Your Feedback</label>
                        <textarea name="TheReview" class="form-control" rows="3" placeholder="Share your experience with this product..." required></textarea>
                    </div>

                    <button type="submit" class="btn btn-action btn-add-cart">
                        <i class="fa-solid fa-paper-plane me-1"></i> Submit Review
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="alert alert-info d-flex align-items-center justify-content-between mb-4">
                <span><i class="fa-solid fa-circle-info me-2"></i> You need to be logged in to leave a review.</span>
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-sm btn-outline-primary">Login Now</a>
            </div>
        }

        <!-- 3. قائمة المراجعات السابقة -->
        <h5 class="fw-bold text-dark mb-3">Customer Feedback</h5>
        @if (Model.Reviews != null && Model.Reviews.Any())
        {
            @foreach (var review in Model.Reviews)
            {
                <div class="review-item">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <!-- استخراج أول حرفين كصورة رمزية -->
                        <div class="user-avatar-initials">
                            @(string.IsNullOrWhiteSpace(review.UserName) ? "U" : (review.UserName.Length >= 2 ? review.UserName.Substring(0, 2) : review.UserName))
                        </div>
                        <div>
                            <div class="fw-bold text-dark">@review.UserName</div>
                            <div class="text-muted small">@review.CreationDate.ToString("dd MMM yyyy")</div>
                        </div>
                    </div>

                    <div class="stars-outer mb-2" style="font-size: 0.95rem;">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= review.Rate)
                            {
                                <i class="fa-solid fa-star"></i>
                            }
                            else
                            {
                                <i class="fa-regular fa-star"></i>
                            }
                        }
                    </div>

                    <p class="text-secondary mb-0">@review.TheReview</p>
                </div>
            }
        }
        else
        {
            <p class="text-muted">No reviews yet for this product. Be the first to share your thoughts!</p>
        }
    </div>
</div>