@{
    ViewData["Title"] = "Check Your Email";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 75vh;">
    <div class="card shadow-lg border-0 rounded-4 p-4 p-md-5 text-center" style="max-width: 540px;">
        
        <!-- Mail Icon ✉️ -->
        <div class="mb-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle" style="width: 90px; height: 90px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="45" height="45" fill="currentColor" class="bi bi-envelope-check" viewBox="0 0 16 16">
                    <path d="M2 2a2 2 0 0 0-2 2v8.01A2 2 0 0 0 2 14h5.5a.5.5 0 0 0 0-1H2a1 1 0 0 1-.966-.741l5.64-3.471L8 9.083l2.326-1.295 5.64 3.471A1 1 0 0 1 14 13h-1.5a.5.5 0 0 0 0 1H14a2 2 0 0 0 2-1.99V4a2 2 0 0 0-2-2zM1 4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1L8 8.414z"/>
                    <path d="M16 12.5a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0m-1.993-1.679a.5.5 0 0 0-.686.172l-1.17 1.95-.547-.547a.5.5 0 0 0-.708.708l1 1a.5.5 0 0 0 .752-.044l1.5-2.5a.5.5 0 0 0-.141-.739"/>
                </svg>
            </div>
        </div>

        <!-- Headings 📝 -->
        <h2 class="fw-bold mb-2">Check Your Email</h2>
        <p class="text-muted mb-4">
            We have sent a confirmation link to your email address. Please click the link to activate your account.
        </p>

        <!-- Help Box 💡 -->
        <div class="alert alert-light border text-start small text-muted mb-4">
            <p class="mb-1"><strong>Didn't receive the email?</strong></p>
            <ul class="mb-0 ps-3">
                <li>Check your <strong>Spam / Junk</strong> folder.</li>
                <li>Make sure your email address was typed correctly.</li>
            </ul>
        </div>

        <!-- Action Buttons 🔘 -->
        <div class="d-grid gap-2">
            <a asp-action="Login" asp-controller="Account" class="btn btn-primary btn-lg rounded-pill">
                Back to Login
            </a>
            @* <a asp-action="Index" asp-controller="Home" class="btn btn-link text-decoration-none text-secondary">
                Return to Home Page
            </a> *@
        </div>

    </div>
</div>