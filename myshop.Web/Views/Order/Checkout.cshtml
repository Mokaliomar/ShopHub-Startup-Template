@model InvoiceVM
@{
    ViewData["Title"] = "Checkout - ShopHub";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="container py-5">
    <div class="mb-4">
        <h2 class="fw-bold text-primary-dark"><i class="fa-solid fa-bag-shopping me-2"></i> Checkout</h2>
        <p class="text-muted">Please review your order and complete the delivery information.</p>
    </div>

    <form method="post" asp-controller="Order" asp-action="ProcessOrder" class="row g-4">
        
        <!-- Left Column: Shipping & Contact Details -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-truck-fast me-2 text-primary"></i> Delivery Details</h5>
                
                <div class="row g-3">
                    <!-- Full Name (Pre-filled) -->
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold">Full Name</label>
                        <input asp-for="OrderHeader.Name" value="@Model.OrderHeader?.Name" class="form-control rounded-3" required />
                    </div>

                    <!-- Phone Number (Required/Missing) -->
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold">Phone Number</label>
                        <input type="tel" name="OrderHeader.PhoneNumber" value="@Model.OrderHeader?.PhoneNumber" placeholder="e.g. 010xxxxxxxx" class="form-control rounded-3" required />
                    </div>

                    <!-- Street Address (Pre-filled if exists) -->
                    <div class="col-12">
                        <label class="form-label text-muted small fw-bold">Street Address</label>
                        <input asp-for="OrderHeader.Address" value="@Model.OrderHeader?.Address" class="form-control rounded-3" placeholder="Apartment, suite, unit, street" required />
                    </div>

                    <!-- City -->
                    <div class="col-md-5">
                        <label class="form-label text-muted small fw-bold">City</label>
                        <input asp-for="OrderHeader.City" value="@Model.OrderHeader?.City" class="form-control rounded-3" required />
                    </div>

                    <!-- State / Region -->
                    <div class="col-md-4">
                        <label class="form-label text-muted small fw-bold">State / Governorate</label>
                        <input asp-for="OrderHeader.Carrier" value="@Model.OrderHeader?.Carrier" class="form-control rounded-3" placeholder="e.g. Cairo, Giza" />
                    </div>

                    <!-- ZIP / Postal Code -->
                    <div class="col-md-3">
                        <label class="form-label text-muted small fw-bold">Postal Code</label>
                        <input asp-for="OrderHeader.TrackingNumber" class="form-control rounded-3" placeholder="e.g. 12345" />
                    </div>
                </div>
            </div>

            <!-- Payment Method Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-credit-card me-2 text-primary"></i> Payment Method</h5>
                <div class="form-check p-3 border rounded-3 bg-light d-flex align-items-center">
                    <input class="form-check-input ms-0 me-3" type="radio" name="paymentType" id="cod" value="COD" checked>
                    <label class="form-check-label d-flex justify-content-between w-100" for="cod">
                        <span class="fw-semibold text-dark">Cash on Delivery (Simulated Payment)</span>
                        <i class="fa-solid fa-money-bill-wave text-success fs-5"></i>
                    </label>
                </div>
            </div>
        </div>

        <!-- Right Column: Order Items & Summary -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 20px;">
                <h5 class="fw-bold text-dark mb-3">Order Summary</h5>

                <!-- Items Mini-List -->
                <ul class="list-group list-group-flush mb-3">
                    @foreach (var item in Model.OrderDetails)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-light">
                            <div>
                                <h6 class="my-0 text-truncate" style="max-width: 200px;">@item.Product.Name</h6>
                                <small class="text-muted">Qty: @item.Count × @item.Price.ToString("C2")</small>
                            </div>
                            <span class="text-muted fw-bold">@((item.Price * item.Count).ToString("C2"))</span>
                        </li>
                    }
                </ul>

                <!-- Calculation Details -->
                <div class="d-flex justify-content-between mb-2 text-muted">
                    <span>Subtotal</span>
                    <span>@Model.OrderHeader?.TotalPrice.ToString("C2")</span>
                </div>
                <div class="d-flex justify-content-between mb-2 text-muted">
                    <span>Shipping</span>
                    <span class="text-success fw-semibold">Free</span>
                </div>
                <hr class="my-3">
                <div class="d-flex justify-content-between mb-4">
                    <span class="fs-5 fw-bold text-dark">Grand Total</span>
                    <span class="fs-5 fw-bold text-primary">@Model.OrderHeader?.TotalPrice.ToString("C2")</span>
                </div>

                <input type="hidden" name="OrderHeader.TotalPrice" value="@Model.OrderHeader?.TotalPrice" />

                <!-- Submit Button -->
                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3 fw-bold py-3 shadow">
                    <i class="fa-solid fa-lock me-2"></i> Place Order
                </button>
            </div>
        </div>

    </form>
</div>