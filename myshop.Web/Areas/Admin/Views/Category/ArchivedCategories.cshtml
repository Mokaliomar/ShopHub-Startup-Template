@using Microsoft.CodeAnalysis.Scripting
@model IEnumerable<Category>

@{
    ViewBag.PageTitle = "Category Management";
    ViewBag.CardTitle = "View Categories";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<!-- Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    /* Card */
    .custom-card {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid #d0d7de;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
        padding: 20px;
    }

    .custom-card-header {
        background: #f1f5fb;
        border-bottom: 1px solid #d0d7de;
        padding: 18px 0;
        text-align: center;
        margin-bottom: 20px;
    }

    .custom-card-header h4 {
        color: #1e3a8a;
        /* أزرق فخم */
        font-weight: 700;
        margin: 0;
    }

    /* Table */
    .table-custom {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 10px;
    }

    .table-custom th {
        background-color: #1e40af;
        color: white;
        font-weight: 600;
        padding: 12px;
        border-radius: 8px 8px 0 0;
    }

    .table-custom td {
        background-color: #fefefe;
        padding: 12px;
        color: #1e3a8a;
        vertical-align: middle;
        border-bottom: 1px solid #e2e8f0;
        border-radius: 0;
    }

    .table-custom tr:hover td {
        background-color: #e0ebff;
        transition: 0.2s;
    }

    /* Buttons */
    .btn-primary {
        padding: 8px 18px;
        border-radius: 8px;
        font-weight: 600;
        background-color: #1e40af;
        color: white;
        box-shadow: 0 4px 12px rgba(30, 64, 175, 0.3);
        border: none;
    }

    .btn-primary:hover {
        background-color: #1e3a8a;
        box-shadow: 0 6px 15px rgba(30, 64, 175, 0.4);
    }

    .btn-success {
        padding: 6px 14px;
        border-radius: 8px;
        background-color: #16a34a;
        color: white;
        font-weight: 600;
        border: none;
        box-shadow: 0 3px 10px rgba(22, 163, 74, 0.3);
    }

    .btn-success:hover {
        background-color: #15803d;
        box-shadow: 0 4px 12px rgba(22, 163, 74, 0.4);
    }

    .btn-danger {
        padding: 6px 14px;
        border-radius: 8px;
        background-color: #dc2626;
        color: white;
        font-weight: 600;
        border: none;
        box-shadow: 0 3px 10px rgba(220, 38, 38, 0.3);
    }

    .btn-danger:hover {
        background-color: #b91c1c;
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.4);
    }

    .top-btn {
        display: flex;
        margin-bottom: 15px;
        justify-content: space-between;
    }

    .btn-archive {
        padding: 10px 22px;
        border-radius: 10px;
        font-weight: 600;
        border: none;
        background: linear-gradient(135deg, #475569, #64748b);
        color: white;
        box-shadow: 0 6px 20px rgba(71, 85, 105, .35);
        text-decoration: none;
    }

    .btn-archive:hover {
        background: linear-gradient(135deg, #334155, #475569);
        transform: translateY(-2px);
        color: white;
    }
</style>

<div class="custom-card">

    <div class="custom-card-header">
        <h4><i class="fa-solid fa-folder-open me-2"></i> @ViewBag.CardTitle</h4>
    </div>

    <div class="top-btn">
        <a asp-controller="Category" asp-action="Index" class="btn btn-archive">
            <i class="fa-solid fa-box-archive me-1"></i> View Categories
        </a>

        <a class="btn btn-primary" href="/Admin/Category/Create">
            <i class="fa-solid fa-circle-plus me-1"></i> Create Category
        </a>
    </div>

    <table id="mytable" width="100%">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Date Created</th>
                <th>Actions</th>
            </tr>
        </thead>
    </table>

</div>

@section Scripts {
    <script src="~/js/archivedCategories.js"></script>
}
